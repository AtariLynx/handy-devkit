* This code is called whenever a non-NMI interrupt occurs (either a hardware
* interrupt or execution of a software BRK).

UserIntHandler
		PHA
		PHX

	  #IFDEF BRK_USER
	  ;-- Check if we got here because of a BRK instruction and JMP to
	  ;-- the BRK routine if so, else branch to the interrupt dispatcher
		TSX
		INX
		INX
		INX
		LDA $0100,X		; Get a copy of the status byte
		bit #$10		; Check break bit
		BNE brkInt		; and branch if clear (hardware int)
	  #ENDIF ; of #IFDEF BRK_USER

hardInt
		;------	We had a hardware interrupt.
		;------	Get the interrupt flags value, reset the bits
		LDA INTSET		; This gets the bits

	  #IFDEF SERIALPORT_USER
		bit #SERIAL_INT		; quick check for serial interrupt
		beq .02
		jmp (sysIntTable+{4*2})	; skip to serial IRQ now!
	  #ENDIF

.02		STA INTSET_RAM

		;------	For least set bit in the interrupt value,
		;------	vector to the routine
		LDX #0
		lda #1
.00		  bit INTSET_RAM
		  bne jumpIntTable
		  INX
		  INX
		  asl a
		 bne .00
IntReturn
		;------	At end of interrupt processing, restore the
		;------	registers and return from interrupt

		PLX
		PLA
		RTI




* The above interrupt dispatcher does a JSR to this line of code.
* This code jumps to the particular handler.  The interrupt dispatcher
* should end with an RTS, which will return control to the above code.

jumpIntTable
		sta INTRST	; clear interrupt we're processing
		JMP	(sysIntTable,X)


	  #IFDEF BRK_USER
brkInt
		PLX
		PLA
BRK_vector	HBRK			; force BRK on Howard board
		JMP BRK_vector		; Will be modified by INITINT call
	  #ENDIF ; of #IFDEF BRK_USER


