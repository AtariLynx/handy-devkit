* The INITLIT macro initializes an Handy Print buffer as a completely-literal
* sprite bufer.  After this macro has been invoked, each line ofthe buffer has
* an offset to the next line of the buffer, and the last offset is initialized
* to 0.  The buffer is presumed to be Width (as specified by argument 1) times
* FONT_HEIGHT plus 1 big.
* The first argument specifies the address of the buffer.
* The second argument specifies the byte-width of each buffer line.
* NOTE:  the buffer line width includes the sprite data line offset byte,
* which means that the number of characters you can print to a buffer  is
* buffer line width minus one.  For a full-screen width buffer, specify a
* width of 21 (20 characters * 8 per character equals 160 pixels).
	#MACRO INITLIT
	LDA #<?0
	LDX #>?0
	STA sysptr
	STX sysptr+1
	LDX #FONT_HEIGHT
??	.= *
	  lda #?1
	  STA (sysptr)
	  CLC
	  ADC sysptr
	  STA sysptr
	  bcc ??1
	  inc sysptr+1
??1	.= *
	  DEX
	 BNE ??
	LDA #0
	STA (sysptr)
	#ENDMACRO



* The HPRFONT macro causes the FontBase variable to be declared and for
* the pieces of the desired font to be loaded.  If you are going to use
* HPRINT either you use HPRFONT or you take all the steps that HPRFONT takes.
* The first argument should be a text string describing the name of the font
* (the normal system font is named "plain").
* ??? NOTE:  currently only supports FONT_HEIGHT of 7

	#MACRO HPRFONT
FontBase  ;-- Load in only the font pieces requested by caller
	    .IN 6502:fonts/?0_space7.src
	  #IF {FONT_TYPE&HPR_DIGIT} <> 0
	    .IN 6502:fonts/?0_digit7.src
	  #ENDIF
	  #IF {FONT_TYPE&HPR_UPPER} <> 0
	    .IN 6502:fonts/?0_upper7.src
	  #ENDIF
	  #IF {FONT_TYPE&HPR_LOWER} <> 0
	    .IN 6502:fonts/?0_lower7.src
	  #ENDIF
	  #IF {FONT_TYPE&HPR_PUNC} <> 0
	    .IN 6502:fonts/?0_punc7.src
	  #ENDIF
	  #IF {FONT_TYPE&HPR_OTHER} <> 0
	    .IN 6502:fonts/?0_other7.src
	  #ENDIF
	    .IN 6502:fonts/?0_nix7.src
	#ENDMACRO



* The HPR_CHARSET macro is used to specify that you want an alternate
* character set to be used for your ASCII characters.  This alternate
* character set will match the character positions generated by a
* call to the HPRFONT macro.
* Here, we load in a character set that contains the ASCII translations
* according to the font requests of the user.  Note that undefined
* ASCII is translated into the NIXFONT character

	#MACRO HPR_CHARSET
	  #IF {FONT_TYPE&HPR_OTHER} != 0
	    #IF {FONT_TYPE&HPR_PUNC} != 0
	      #IF {FONT_TYPE&HPR_LOWER} != 0
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_PUNC+HPR_LOWER+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_1f.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_PUNC+HPR_LOWER+HPR_UPPER
	            .CS 6502:fonts/cset_1e.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_PUNC+HPR_LOWER+HPR_DIGIT
	            .CS 6502:fonts/cset_1d.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_PUNC+HPR_LOWER
	            .CS 6502:fonts/cset_1c.src
	          #ENDIF
	        #ENDIF
	      #ELSE
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_PUNC+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_1b.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_PUNC+HPR_UPPER
	            .CS 6502:fonts/cset_1a.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_PUNC+HPR_DIGIT
	            .CS 6502:fonts/cset_19.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_PUNC
	            .CS 6502:fonts/cset_18.src
	          #ENDIF
	        #ENDIF
	      #ENDIF
	    #ELSE
	      #IF {FONT_TYPE&HPR_LOWER} != 0
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_LOWER+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_17.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_LOWER+HPR_UPPER
	            .CS 6502:fonts/cset_16.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_LOWER+HPR_DIGIT
	            .CS 6502:fonts/cset_15.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_LOWER
	            .CS 6502:fonts/cset_14.src
	          #ENDIF
	        #ENDIF
	      #ELSE
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_13.src
	          #ELSE
	            ;-- HPR_OTHER+HPR_UPPER
	            .CS 6502:fonts/cset_12.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_OTHER+HPR_DIGIT
	            .CS 6502:fonts/cset_11.src
	          #ELSE
	            ;-- HPR_OTHER
	            .CS 6502:fonts/cset_10.src
	          #ENDIF
	        #ENDIF
	      #ENDIF
	    #ENDIF
	  #ELSE ; no HPR_OTHER
	    #IF {FONT_TYPE&HPR_PUNC} != 0
	      #IF {FONT_TYPE&HPR_LOWER} != 0
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_PUNC+HPR_LOWER+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_0f.src
	          #ELSE
	            ;-- HPR_PUNC+HPR_LOWER+HPR_UPPER
	            .CS 6502:fonts/cset_0e.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_PUNC+HPR_LOWER+HPR_DIGIT
	            .CS 6502:fonts/cset_0d.src
	          #ELSE
	            ;-- HPR_PUNC+HPR_LOWER
	            .CS 6502:fonts/cset_0c.src
	          #ENDIF
	        #ENDIF
	      #ELSE
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_PUNC+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_0b.src
	          #ELSE
	            ;-- HPR_PUNC+HPR_UPPER
	            .CS 6502:fonts/cset_0a.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_PUNC+HPR_DIGIT
	            .CS 6502:fonts/cset_09.src
	          #ELSE
	            ;-- HPR_PUNC
	            .CS 6502:fonts/cset_08.src
	          #ENDIF
	        #ENDIF
	      #ENDIF
	    #ELSE
	      #IF {FONT_TYPE&HPR_LOWER} != 0
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_LOWER+HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_07.src
	          #ELSE
	            ;-- HPR_LOWER+HPR_UPPER
	            .CS 6502:fonts/cset_06.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_LOWER+HPR_DIGIT
	            .CS 6502:fonts/cset_05.src
	          #ELSE
	            ;-- HPR_LOWER
	            .CS 6502:fonts/cset_04.src
	          #ENDIF
	        #ENDIF
	      #ELSE
	        #IF {FONT_TYPE&HPR_UPPER} != 0
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_UPPER+HPR_DIGIT
	            .CS 6502:fonts/cset_03.src
	          #ELSE
	            ;-- HPR_UPPER
	            .CS 6502:fonts/cset_02.src
	          #ENDIF
	        #ELSE
	          #IF {FONT_TYPE&HPR_DIGIT} != 0
	            ;-- HPR_DIGIT
	            .CS 6502:fonts/cset_01.src
	          #ELSE
	            .ECHO ""
	            .ECHO "ERROR:  No font FONT_TYPES flags set!"
	            .ECHO ""
	          #ENDIF
	        #ENDIF
	      #ENDIF
	    #ENDIF
	  #ENDIF
	#ENDMACRO


* The HPRINT macro causes your text to be printed
* The first arg is the text pointer, which can point to one of two things
* depending on the value of the second arg.
* The second arg should be 0 or 1, standing for:
*     0 = first arg is the address of the text
*     1 = first arg is the address of a variable pointing to the text addr
* The third arg is the address of your buffer, which should already be
* initialized as a completely-literal sprite buffer (see INITLIT).

	#MACRO HPRINT

	  #IF	?1 = 1
	    LDA ?0
	    STA	sysptr
	    LDA ?0+1
	    STA sysptr+1
	  #ELSE
	    LDA #<?0
	    STA sysptr
	    LDA #>?0
	    STA sysptr+1
	  #ENDIF

	  LDA #<?2
	  STA TextPtr
	  LDA #>?2
	  STA TextPtr+1
	  JSR HandyPrint

	#ENDMACRO


